{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-voice-moodboards",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "MAX_CLASS_COMMANDS_PER_DAY": "300", "MAX_STORAGE_BYTES": "8000000000" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "classroom-moodboards",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "classroom-moodboard-images" }],
  "durable_objects": { "bindings": [{ "name": "TASKS", "class_name": "ClassroomTasks" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomTasks"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "classroom-image-jobs" }],
    "consumers": [{
      "queue": "classroom-image-jobs", "max_batch_size": 1,
      "max_batch_timeout": 1, "max_concurrency": 6, "max_retries": 5,
      "retry_delay": 30, "dead_letter_queue": "classroom-image-jobs-dlq"
    }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
